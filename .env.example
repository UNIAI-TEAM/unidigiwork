# UNIWORK — biến môi trường (CHỈ TÊN BIẾN, không chứa giá trị thật).
# Bản .env thực tế do Lovable Cloud / hạ tầng cung cấp, không commit.

# Backend (Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# AI Gateway
LOVABLE_API_KEY=

# Hội nghị trực tuyến
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# Làm mờ phông nền (MediaPipe). Bỏ trống thì tải mô hình từ CDN công khai của
# Google/jsDelivr. Bản self-host kín mạng thì trỏ hai biến này về máy chủ nội bộ.
VITE_MEDIAPIPE_TASKS_URL=
VITE_MEDIAPIPE_SEGMENTER_URL=
